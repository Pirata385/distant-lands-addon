{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "dl:lod_wall",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/dl_lod"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "v.ox",
          "v.oy",
          "v.oz"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initialization": {
        "per_render_expression": "v.k = v.grow > 0 ? math.clamp(v.particle_age / v.grow, 0, 1) : 1; v.k = v.k * v.k * (3 - 2 * v.k); v.lit = math.clamp(v.l0 + v.dl * v.particle_age, 0.05, 1);"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sa * v.k",
          "v.sb * v.k"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.cr * v.lit",
          "v.cg * v.lit",
          "v.cb * v.lit",
          1
        ]
      },
